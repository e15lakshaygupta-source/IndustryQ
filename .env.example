DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=your-domain.example,www.your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example
DB_ENGINE=postgresql
DB_NAME=industryos
DB_USER=industryos
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
TRUST_PROXY_SSL_HEADER=1
DJANGO_LOG_LEVEL=INFO
